&CONTROL
  calculation = 'scf'
  prefix = 'cuin2k'
  outdir = './tmp'
  pseudo_dir = '/usr/share/espresso/pseudo'
  tprnfor = .true.
  tstress = .true.
/

&SYSTEM
  ibrav = 0
  nat = 4
  ntyp = 3
  ecutwfc = 50
  ecutrho = 400
  occupations = 'smearing'
  smearing = 'cold'
  degauss = 0.02
/

&ELECTRONS
  conv_thr = 1.0d-6
  mixing_beta = 0.3
/

ATOMIC_SPECIES
  Cu      63.5460  Cu.pbe-dn-kjpaw_psl.1.0.0.UPF
  In     114.8180  In.pbe-dn-kjpaw_psl.1.0.0.UPF
  K       39.0980  K.pbe-spn-kjpaw_psl.1.0.0.UPF

