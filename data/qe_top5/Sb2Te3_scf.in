&CONTROL
  calculation = 'scf'
  prefix = 'sb2te3'
  outdir = './tmp'
  pseudo_dir = '/usr/share/espresso/pseudo'
  tprnfor = .true.
  tstress = .true.
/

&SYSTEM
  ibrav = 0
  nat = 5
  ntyp = 2
  ecutwfc = 50
  ecutrho = 400
  occupations = 'smearing'
  smearing = 'cold'
  degauss = 0.02
/

&ELECTRONS
  conv_thr = 1.0d-6
  mixing_beta = 0.3
/

